# Allow packaged bootstrap templates even when generated target files are ignored.
!ai_workflow_bootstrap/template_packs/
!ai_workflow_bootstrap/template_packs/**
ai_workflow_bootstrap/template_packs/**/__pycache__/
ai_workflow_bootstrap/template_packs/**/*.py[cod]
!ai_workflow_bootstrap/template_packs/default/templates/AGENTS.md
!ai_workflow_bootstrap/template_packs/default/templates/.agents/
!ai_workflow_bootstrap/template_packs/default/templates/.agents/**
